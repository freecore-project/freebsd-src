+/*
+ * A crafted RAR5 archive with a symlink entry whose target_size varint
+ * is pathologically large. In parse_file_extra_redir(), subtracting
+ * target_size and varint_len from *extra_data_size before validating
+ * the bounds of target_size triggers a signed integer overflow in
+ * int64_t arithmetic. The fix moves the bounds checks before the
+ * arithmetic so the malformed archive is rejected with ARCHIVE_FATAL.
+ */
+DEFINE_TEST(test_read_format_rar5_redir_overflow)
+{
+	struct archive *a;
+	struct archive_entry *ae;
+
+	extract_reference_file(
+	    "test_read_format_rar5_redir_overflow.rar");
+	a = archive_read_new();
+	assert(a != NULL);
+	assertEqualIntA(a, ARCHIVE_OK, archive_read_support_format_rar5(a));
+	assertEqualIntA(a, ARCHIVE_OK, archive_read_open_filename(a,
+	    "test_read_format_rar5_redir_overflow.rar", 10240));
+	assertEqualIntA(a, ARCHIVE_FATAL, archive_read_next_header(a, &ae));
+	assertEqualInt(ARCHIVE_OK, archive_read_free(a));
+}
