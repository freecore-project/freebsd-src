index 0000000000000000000000000000000000000000..843bfb5d7f7fa0128d67aa4d9228adf7f79214ff
--- /dev/null
+++ b/contrib/libarchive/libarchive/test/test_write_format_mtree_null_deref.c
@@ -0,0 +1,233 @@
+/*-
