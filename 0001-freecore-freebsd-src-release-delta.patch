+    for (i = 0; i < NUM_RETRANSMITS; i++) {
+        write_calls_before = fb->write_calls;
+
+        if (!TEST_int_gt((int)DTLSv1_get_timeout(clientssl, &tv), 0))
+            goto end;
+
