index 0000000000000000000000000000000000000000..12be811a72d97ed6366e1c00c30a2112eaae758d
--- /dev/null
+++ b/contrib/libarchive/libarchive/test/test_write_format_iso9660_zisofs_overflow.c
@@ -0,0 +1,127 @@
+/*-SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Copyright (c) 2026 Dustin L. Howett
+ * All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
