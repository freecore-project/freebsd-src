index 0000000000000000000000000000000000000000..1b937fd50152d7534521bde1cb1334df0e545637
--- /dev/null
+++ b/contrib/libarchive/libarchive/test/test_create_child_environment.c
@@ -0,0 +1,108 @@
+/*-
+ * Copyright (c) 2026 François Degros
+ * All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
