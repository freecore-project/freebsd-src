diff --git a/contrib/libarchive/libarchive/test/test_archive_seek_data_unsupported.c b/contrib/libarchive/libarchive/test/test_archive_seek_data_unsupported.c
new file mode 100644
index 0000000000000000000000000000000000000000..d64bb30c01e265a1a1225e19f05ce14e7370f4cd
--- /dev/null
+++ b/contrib/libarchive/libarchive/test/test_archive_seek_data_unsupported.c
@@ -0,0 +1,95 @@
+/*-
+ * Copyright (c) 2026 tbontb-iaq
+ * All rights reserved.
+ *
