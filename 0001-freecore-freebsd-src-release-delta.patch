+static char *nvdimm_root_ids[] = { "ACPI0012", NULL };
+static uint8_t pmem_uuid[ACPI_UUID_LENGTH] = {
+	0x79, 0xd3, 0xf0, 0x66, 0xf3, 0xb4, 0x74, 0x40,
+	0xac, 0x43, 0x0d, 0x33, 0x18, 0xb7, 0x8c, 0xdb
+};
