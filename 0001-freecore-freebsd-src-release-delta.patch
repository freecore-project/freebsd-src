+static int
+nvdimm_root_get_domain(device_t dev, device_t child, int *domain)
+{
+	struct nvdimm_child *ivar;
+
+	ivar = (struct nvdimm_child *)device_get_ivars(child);
+	if (ivar->domain >= 0) {
+		*domain = ivar->domain;
+		return (0);
+	}
+	return (bus_generic_get_domain(dev, child, domain));
+}
