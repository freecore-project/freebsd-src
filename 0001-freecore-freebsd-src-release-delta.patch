diff --git a/contrib/libarchive/libarchive/test/test_read_format_7zip_ppmd_bcj.7z.uu b/contrib/libarchive/libarchive/test/test_read_format_7zip_ppmd_bcj.7z.uu
new file mode 100644
index 0000000000000000000000000000000000000000..a9ce2d477a3ebb31fa90fa26d94c3fd964cfe502
--- /dev/null
+++ b/contrib/libarchive/libarchive/test/test_read_format_7zip_ppmd_bcj.7z.uu
@@ -0,0 +1,47 @@
+The payload is synthetic, generated by the script below: mostly ARM64
+nops, with a branch instruction every 16th and 8th word and a little
+incompressible noise, so that both the ARM64 and the x86 filter have
+something to convert and PPMd still compresses it down to a few
+hundred bytes.
+
+    python3 gen.py 2000 ppmd-bcj.bin
+
+    import struct, sys, zlib
+    n = int(sys.argv[1])
+    state = 0x2545f491
+    out = bytearray()
+    while len(out) < n:
+        i = len(out) // 4
+        pc = len(out)
+        if i % 16 == 0:                                          # arm64 bl
+            w = 0x94000000 | (((0x40000 - pc) >> 2) & 0x03ffffff)
+        elif i % 16 == 8:                                        # x86-ish call
+            w = 0x000000e8 | ((pc << 8) & 0xffffff00)
+        elif i % 64 == 20:                                       # a little noise
+            state = (state * 1103515245 + 12345) & 0xffffffff
+            w = state
+        else:
+            w = 0xd503201f                                       # nop
+        out += struct.pack('<I', w)
+    data = bytes(out[:n])
+    open(sys.argv[2], 'wb').write(data)
+    print(len(data), '0x%08x' % (zlib.crc32(data) & 0xffffffff))
+
+rm -f libarchive/test/test_read_format_7zip_ppmd_bcj.7z
+7z a -m0=BCJ -m1=PPMd -mhc=off -mtm=off libarchive/test/test_read_format_7zip_ppmd_bcj.7z ppmd-bcj.bin -y
+
+-mtm=off keeps the result reproducible; the test does not check mtime.
+
+And then uuencoding the resulting archive.
+
