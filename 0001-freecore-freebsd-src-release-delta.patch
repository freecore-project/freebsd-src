+static int
+reg_parse(const char *name, int *page, int *off, int *size)
+{
+	int i, l, o = -1;
+
+	for (i = 0; regs[i].name != NULL; i++) {
+		l = strlen(regs[i].name);
+		if (strncmp(name, regs[i].name, l) != 0)
+			continue;
+		if (name[l] == 0)
+			break;
+		if (name[l] - '0' < regs[i].size) {
+			o = name[l] - '0';
+			break;
+		}
+	}
+	if (regs[i].name == NULL)
+		return (0);
+	*page = regs[i].page;
+	if (o >= 0) {
+		*off = regs[i].off + o;
+		*size = 1;
+	} else {
+		*off = regs[i].off;
+		*size = regs[i].size;
+	}
+	return (1);
+}
