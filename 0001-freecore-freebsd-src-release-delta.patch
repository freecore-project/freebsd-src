+
+	/*
+	 * Verify that a filename mixing valid and untranslatable bytes does
+	 * not overrun the conversion buffer while substituting '?' for the
+	 * untranslatable characters under a four-byte hdrcharset (UTF-32).
+	 */
+	a = archive_write_new();
