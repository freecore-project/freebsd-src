+
+		snp = i2c_read(fd, 0, 1);
+		vsp = i2c_read(fd, 0, 2);
+		vnp = i2c_read(fd, 0, 3);
+		for (page = 0; page < snp; page++) {
+			printf("Page 0x%02x:\n", page);
+			for (off = 0; off < 256; off++) {
+				printf(" %02x", i2c_read(fd, page, off));
+				if ((off % 16) == 15)
+					printf("\n");
+			}
+		}
+		for (page = vsp; page < vsp+vnp; page++) {
+			printf("Page 0x%02x:\n", page);
+			for (off = 0; off < 256; off++) {
+				printf(" %02x", i2c_read(fd, page, off));
+				if ((off % 16) == 15)
