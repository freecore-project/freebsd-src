@@ -1900,7 +1897,9 @@ run_rc_script()
 #		Pass "arg" to `run_rc_script' default is $_boot.
 #
 #	--break "marker"
-#		If any "file" matches "marker" stop processing.
+#		If any "file" matches "marker" stop processing.  "marker" is a
+#		shell pattern matched against the script's basename, so a plain
+#		name matches only itself and "*" stops after the first script.
 #
 _rc_elem_done=
 run_rc_scripts()
@@ -1908,6 +1907,7 @@ run_rc_scripts()
 	local _arg=${_boot}
 	local _rc_elem
 	local _rc_breaks=
+	local _rc_break _rc_opts _rc_stop
 
 	while :; do
 		case "$1" in
@@ -1933,11 +1933,37 @@ run_rc_scripts()
 		esac
 		run_rc_script ${_rc_elem} ${_arg}
 		_rc_elem_done="$_rc_elem_done $_rc_elem"
-		case " $_rc_breaks " in
-		*" ${_rc_elem##*/} "*)
-                        break
-                        ;;
+		#
+		# Match every marker as a shell PATTERN against the script's
+		# basename.  Looking the basename up inside the marker list
+		# instead -- as this did before -- silently ignores a wildcard
+		# divider: early_late_divider="*" then never fires, the early
+		# pass runs the whole of /etc/rc.d, and scripts such as hostname
+		# and watchdogd read configuration that /etc/ix.rc.d/ix-etc has
+		# not generated yet.  See the internal development record.
+		#
+		# Path expansion is disabled around the split so that a marker
+		# stays a pattern instead of being replaced by whatever happens
+		# to match it in the current directory.
+		#
+		_rc_stop=
+		_rc_opts=$-
+		set -f
+		for _rc_break in ${_rc_breaks}; do
+			case "${_rc_elem##*/}" in
+			${_rc_break})
+				_rc_stop=yes
+				break
+				;;
+			esac
+		done
+		case ${_rc_opts} in
+		*f*)	;;
+		*)	set +f ;;
 		esac
+		if [ -n "${_rc_stop}" ]; then
+			break
+		fi
 	done
 }
 
