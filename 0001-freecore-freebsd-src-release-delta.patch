index 0000000000000000000000000000000000000000..a3885e44447d18085b53f52ab8b2637fcfd10d2d
--- /dev/null
+++ b/contrib/libarchive/libarchive/test/test_archive_pathmatch_oob.c
@@ -0,0 +1,156 @@
+/*-
