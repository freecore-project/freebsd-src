index 0000000000000000000000000000000000000000..ecf6cc78eb875d28b0185424f6af88fa05b21276
--- /dev/null
+++ b/contrib/libarchive/libarchive/test/test_acl_from_text_overread.c
@@ -0,0 +1,98 @@
+/*-
+ * Copyright (c) 2026 Kaif Khan
+ * All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
